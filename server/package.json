{
  "name": "vextech-server",
  "version": "1.0.0",
  "description": "API e painel de administração de vagas da Vextech",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "migrate": "node src/scripts/migrate.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "seed:admin": "node src/scripts/seed-admin.js"
  },
  "dependencies": {
    "bcrypt": "5.1.1",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "express-rate-limit": "8.7.3",
    "jsonwebtoken": "9.0.2",
    "multer": "2.5.0",
    "mysql2": "3.11.5",
    "pdf-lib": "1.17.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "nodemon": "3.1.9"
  },
  "allowScripts": {
    "bcrypt@5.1.1": true
  }
}
