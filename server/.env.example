PORT=3001

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=vextech
DB_PASSWORD=vextech
DB_NAME=vextech

# Opcional: diretório persistente para as capas enviadas.
# Por omissão: server/uploads/vagas (fora do Git).
# UPLOADS_DIR=/caminho/persistente/capas

# Currículos privados: por omissão, server/private/curriculos.
# CURRICULOS_DIR=/caminho/persistente/curriculos

JWT_SECRET=troca-esta-chave-antes-de-usar-em-producao
JWT_EXPIRES_IN=12h

# Origens (separadas por vírgula) autorizadas a chamar GET /api/vagas a partir do browser.
# localhost e 127.0.0.1 são origens distintas para CORS — o Vite/Playwright usam as duas.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
