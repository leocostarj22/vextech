# Origens (separadas por vírgula) autorizadas a chamar GET /api/vagas a partir do browser.
# localhost e 127.0.0.1 são origens distintas para CORS — o Vite/Playwright usam as duas.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
